# Copy this file to .env.local and fill in your Supabase project keys

# Supabase URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon/Public Key (used on client & server)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (used server-side for admin bypass / operations)
SUPABASE_SERVICE_ROLE_KEY=
