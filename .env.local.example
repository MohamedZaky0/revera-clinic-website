# Copy this file to .env.local and fill in your Supabase project keys

# Supabase URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Supabase Publishable/Anon Key (used on client & server)
SUPABASE_PUBLISHABLE_KEY=

# Supabase Service Role / Secret Key (used server-side only)
SUPABASE_SECRET_KEY=

# Also supported for backwards compatibility:
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
